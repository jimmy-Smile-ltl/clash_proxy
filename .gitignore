# ============================================================
# 私有数据隔离
# 原则：默认忽略；只白名单少数「模板 / 示例」文件
# 详细说明见 docs/private-data.md
# ============================================================

# ---- 环境变量 ----
.env
.env.local
.env.*
!.env.example

# ---- config/：真实订阅、节点列表、地理库、缓存全部不放行 ----
# 只允许模板与说明文件；以后往 config/ 放任何私有文件都自动被忽略
config/*
!config/README.md
!config/config.example.yaml

# ---- 推荐的私有数据目录（整个目录永不入库）----
# 真实订阅、静态节点列表、状态文件、出口 IP 日志都可以放这里
local/
private/
secrets/

# ---- 订阅 / 节点列表（放在仓库根目录时的兜底命名）----
/subscriptions/
/subs/
/subscription*.yaml
/subscription*.yml
/sub*.yaml
/sub*.yml
/*.clash.yaml
/*.clash.yml
/proxies*.txt
/proxy-list*.txt
/nodes*.txt
/node-list*.txt

# ---- 运行时状态（含节点名/出口 IP，不能公开）----
clash_node_state*.json
/*.state.json
/*_state.json
*.priority.json
.clash_priority.json
*.lock
*.tmp
*exit_ip*.tsv
/*exit*.tsv

# ---- Docker 本地覆盖（可能含私有挂载路径）----
docker-compose.override.yml

# ---- Mihomo 运行时生成文件（config/* 已覆盖，保留显式条目方便阅读）----
config/cache.db
config/cache.db.*

# ---- 地理数据库（体积大，按 config/README.md 下载）----
config/geoip.metadb
config/GeoSite.dat

# ---- 凭据 / 私钥 ----
*.pem
*.key
id_rsa*
id_ed25519*
credentials*.json
secrets*.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 日志 ----
logs/
*.log

# ---- IDE ----
.idea/
.vscode/

# ---- 打包产物 ----
dist/
build/
*.whl

# ---- 工具缓存 ----
.ruff_cache/
.pytest_cache/
