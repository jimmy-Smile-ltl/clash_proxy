# 环境变量（复制为 .env 使用，切勿提交真实密钥）
.env
.env.local

# Clash 订阅配置（含真实节点/密钥，严禁入库）
config/config.yaml

# Mihomo 运行时生成文件
config/cache.db
config/cache.db.*

# 节点状态（运行时自动生成）
clash_node_state.json
clash_node_state.json.tmp

# 地理数据库（体积大，按 config/README.md 下载）
config/geoip.metadb
config/GeoSite.dat

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 日志
logs/
*.log

# IDE
.idea/
.vscode/

# 节点优先度状态（运行时生成，含你的节点名）
.clash_priority.json
*.priority.json

# 状态文件的锁与临时文件
*.lock
*.tmp

# 打包产物
dist/
build/
*.whl

# 工具缓存
.ruff_cache/
.pytest_cache/
