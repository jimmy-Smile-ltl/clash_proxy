# Clash 代理池环境变量
# 复制此文件为 .env 并根据实际情况修改（.env 已被 .gitignore 忽略）
#
# 私有数据隔离：真实订阅放 config/config.yaml，静态节点列表 / 状态 / 日志
# 建议统一放 local/（整个目录被忽略）。详见 docs/private-data.md

# Clash API 认证密钥，需与 config/config.yaml 中的 secret 一致
CLASH_SECRET=your-secret-here

# Clash 外部控制地址（Docker 部署默认 9099，本地 Clash 客户端通常是 9090）
CLASH_API_URL=http://127.0.0.1:9099

# 本地代理端口（Docker 部署默认 7777，本地 Clash 客户端通常是 7890）
CLASH_PROXY_PORT=7777

# 策略组名（订阅里节点所在的 Selector 组）
# ⚠️ Clash 处于 global 模式时，实际出口是 GLOBAL 组，这里应填 GLOBAL
CLASH_GROUP_NAME=🚀节点选择

# 切换后连通性检测 URL —— 强烈建议填你实际要采集的目标站
CLASH_TEST_URL=https://www.gstatic.com/generate_204

# 负载均衡策略: round_robin | random | least_403 | least_used
CLASH_SWITCH_STRATEGY=round_robin

# 错误节点黑名单 Redis（可选，多进程共享用；不设置默认本机 6379 无密码）
# CLASH_REDIS_URL=redis://127.0.0.1:6379/0

# ── 出口校验（v2 新增，强烈建议保持默认）────────────────────────
# 切换前后各查一次真实出口 IP 并比对 —— 唯一能识破"切换没生效"的判据
# (rule 模式下 PUT 策略组对流量是 no-op; keep-alive 又会复用旧隧道)
CLASH_VERIFY_EXIT_IP=true
# 国内/部分节点访问 api.ipify.org 可能失败，可换成 https://ifconfig.me/ip
CLASH_EXIT_IP_URL=https://api.ipify.org

# 启动时是否全量测延迟。默认 false：test/status 秒回；
# 要完整测延迟用 python clash_cli.py health 或 sub test。
# 想让每次启动都自动测一遍，改成 true。
CLASH_STARTUP_HEALTH_CHECK=false
# 少数机场多个节点共用同一出口 IP 时设为 true
CLASH_ALLOW_SAME_EXIT_IP=false
# 非空则把 时间/节点/出口IP 追加写入该 TSV，便于事后溯源
CLASH_EXIT_IP_LOG=

# rule 模式下切换策略组不改变实际出口；置 true 让启动时自动切到 global
CLASH_FORCE_GLOBAL_MODE=false

# ── 节点优先度（可选扩展 clash_policy.py）────────────────────────
# 置顶节点（绕过轮换，优先使用）。多个用逗号分隔。
# CLASH_PIN_NODES=🇸🇬 Hy2|新加坡|原生|ISIF
# 拉黑节点
# CLASH_BLOCK_NODES=
# 偏好/排除地区（从节点名或国旗解析）
# CLASH_PREFER_REGIONS=新加坡,日本
# CLASH_EXCLUDE_REGIONS=香港
# 延迟上限(ms)，超过的不进候选
# CLASH_MAX_LATENCY_MS=800
# 优先低倍率线路（识别「0.1倍」这类写法）
CLASH_PREFER_LOW_MULTIPLIER=false

# ── 全池熔断 ───────────────────────────────────────────────────
# 所有出口都在冷却时的静默等待秒数。别调小 —— 服务端整体限流由聚合请求
# 速率维持，继续试探只会延长它（实测静默 1-2 小时后自行恢复）。
CLASH_POOL_EXHAUSTED_WAIT=3600

# ── 静态代理列表（可选扩展 clash_sources.py）────────────────────
# 设了这个就改用静态代理来源：不经过 Clash，每个出口自带代理地址。
# 文件格式每行一条: http://user:pass@host:port / socks5://host:port / host:port:user:pass
# 建议放 local/ 目录（已被 .gitignore 忽略）
# CLASH_STATIC_PROXIES=local/proxies.txt

# ── 多订阅合并 / 定期刷新（可选扩展 clash_subscriptions.py）──────
# 来源列表：每行一个 URL / 文件 / 目录；真实内容只放 local/（已忽略）
CLASH_SUBSCRIPTION_FILE=local/subscriptions.txt
CLASH_SUBSCRIPTION_CACHE=local/subscriptions/cache
CLASH_SUBSCRIPTION_OUT=config/config.yaml
CLASH_SUBSCRIPTION_TEMPLATE=config/config.example.yaml
CLASH_SUBSCRIPTION_GROUP=🚀节点选择
# 巡检间隔（秒），默认 12 小时；建议 12 小时，别太短
CLASH_SUBSCRIPTION_INTERVAL=43200
# 严格更新门控（不可用 --force 绕过）：
#   - 24 小时内最多一次订阅 URL 拉取「尝试」；
#   - 且必须连续 12 小时抽样检测到「全池失败」；
#   - 其余时间只读缓存 / 手动文件，不发订阅请求。
# 下面的 3600 是底层兜底（同一 URL 1 小时内不重复请求）。
CLASH_SUBSCRIPTION_MIN_INTERVAL=3600
# 节点测试冷却（秒）：默认只抽样 5 个；1 小时内不重复；--all 全量冷却 6 小时。
CLASH_NODE_TEST_COOLDOWN=3600
# 基底：auto（第一个带 groups/rules 的来源）/ template / 来源序号(1 起)
CLASH_SUBSCRIPTION_BASE=auto
# 生成配置的 mode：base（保留基底）/ rule / global / direct
CLASH_SUBSCRIPTION_MODE=base
# URL 拉取失败时可走本地代理重试（可选）
# CLASH_SUBSCRIPTION_PROXY=http://127.0.0.1:7897

# 专用实例（可选）：不干扰日常 Clash 客户端，单独跑合并后的节点池
# CLASH_SUBSCRIPTION_API_LISTEN=127.0.0.1:9098
# CLASH_SUBSCRIPTION_MIXED_PORT=7898
# CLASH_SUBSCRIPTION_SECRET=换成你的强随机串
