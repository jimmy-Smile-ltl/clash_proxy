# Clash 代理池环境变量
# 复制此文件为 .env 并根据实际情况修改（.env 已被 .gitignore 忽略）

# Clash API 认证密钥，需与 config/config.yaml 中的 secret 一致
CLASH_SECRET=your-secret-here

# Clash 外部控制地址（Docker 部署默认 9099，本地 Clash 客户端通常是 9090）
CLASH_API_URL=http://127.0.0.1:9099

# 本地代理端口（Docker 部署默认 7777，本地 Clash 客户端通常是 7890）
CLASH_PROXY_PORT=7777

# 策略组名（订阅里节点所在的 Selector 组）
CLASH_GROUP_NAME=🚀节点选择

# 切换后连通性检测 URL —— 强烈建议填你实际要采集的目标站
CLASH_TEST_URL=https://www.gstatic.com/generate_204

# 负载均衡策略: round_robin | random | least_403 | least_used
CLASH_SWITCH_STRATEGY=round_robin

# 错误节点黑名单 Redis（可选，多进程共享用；不设置默认本机 6379 无密码）
# CLASH_REDIS_URL=redis://127.0.0.1:6379/0

# ── 出口校验（v2 新增，强烈建议保持默认）────────────────────────
# 切换前后各查一次真实出口 IP 并比对 —— 唯一能识破"切换没生效"的判据
# (rule 模式下 PUT 策略组对流量是 no-op; keep-alive 又会复用旧隧道)
CLASH_VERIFY_EXIT_IP=true
CLASH_EXIT_IP_URL=https://api.ipify.org
# 少数机场多个节点共用同一出口 IP 时设为 true
CLASH_ALLOW_SAME_EXIT_IP=false
# 非空则把 时间/节点/出口IP 追加写入该 TSV，便于事后溯源
CLASH_EXIT_IP_LOG=

# rule 模式下切换策略组不改变实际出口；置 true 让启动时自动切到 global
CLASH_FORCE_GLOBAL_MODE=false

# ── 节点优先度（可选扩展 clash_policy.py）────────────────────────
# 置顶节点（绕过轮换，优先使用）。多个用逗号分隔。
# CLASH_PIN_NODES=🇸🇬 Hy2|新加坡|原生|ISIF
# 拉黑节点
# CLASH_BLOCK_NODES=
# 偏好/排除地区（从节点名或国旗解析）
# CLASH_PREFER_REGIONS=新加坡,日本
# CLASH_EXCLUDE_REGIONS=香港
# 延迟上限(ms)，超过的不进候选
# CLASH_MAX_LATENCY_MS=800
# 优先低倍率线路（识别「0.1倍」这类写法）
CLASH_PREFER_LOW_MULTIPLIER=false

# ── 全池熔断 ───────────────────────────────────────────────────
# 所有出口都在冷却时的静默等待秒数。别调小 —— 服务端整体限流由聚合请求
# 速率维持，继续试探只会延长它（实测静默 1-2 小时后自行恢复）。
CLASH_POOL_EXHAUSTED_WAIT=3600

# ── 静态代理列表（可选扩展 clash_sources.py）────────────────────
# 设了这个就改用静态代理来源：不经过 Clash，每个出口自带代理地址。
# 文件格式每行一条: http://user:pass@host:port / socks5://host:port / host:port:user:pass
# CLASH_STATIC_PROXIES=proxies.txt
